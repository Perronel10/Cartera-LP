rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function autorizado() {
      return request.auth != null
        && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'password')
        && request.auth.token.email.lower() in ['leandro@estudiojuridicoperrone.com', 'administracion@estudiojuridicoperrone.com'];
    }
    match /archivos/{file} {
      allow read: if autorizado();
      allow write: if autorizado() && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
